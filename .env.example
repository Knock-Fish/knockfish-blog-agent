# 复制本文件为 .env 后填入真实值；.env 已被 .gitignore 排除，请勿提交
# 本文件只包含占位示例，不含任何真实密钥

# ---- 应用 ----
APP_NAME="KnockFish Blog Agent"
APP_ENV="dev"
APP_HOST="0.0.0.0"
APP_PORT=8000
APP_RELOAD=true

# ---- LLM ----
LLM_API_KEY="<你的 API Key>"
LLM_BASE_URL="<兼容 OpenAI 协议的接口地址>"
LLM_MODEL_ID="qwen3.8-max"
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=60

# ---- Spring Boot 后端 Agent 接口 ----
HTTP_BASE_URL="http://localhost:8081/api/agent"
HTTP_TIMEOUT=30

# ---- 数据库（必填，须带异步驱动前缀）----
# asyncpg 驱动：postgresql+asyncpg://user:password@host:5432/dbname
# psycopg 驱动：postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL="postgresql+asyncpg://postgres:<你的密码>@localhost:5432/knockfish"

# ---- JWT（验证 Spring Boot 签发的 token）----
JWT_ALGORITHM="RS256"
JWT_ISSUER=""
# 公钥路径，留空则默认使用 app/certs/jwt_public_key.pem
JWT_PUBLIC_KEY_PATH=""

# ---- CORS（生产环境用 JSON 数组覆盖，勿写进代码）----
CORS_ALLOW_ORIGINS=["http://localhost:5173","http://localhost:8081","http://localhost:8000"]
